# Copy to .env.local and fill in what you need. All optional: the site runs without any of these.
# Never commit .env.local. On Vercel, set the same names under Project → Settings → Environment Variables.

# --- Ledger (Algorand TestNet): 25-word mnemonic of the account that stamps predictions
ALGORAND_MNEMONIC=

# --- Scheduled jobs: long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- On-chain Vault / Guardian (Base Sepolia)
DEPLOYER_PRIVATE_KEY=        # only for scripts/deploy-contracts.mjs
KEEPER_PRIVATE_KEY=          # pushes Oracle prices on-chain and runs the Guardian
RPC_URL=                     # deploy target RPC, e.g. https://sepolia.base.org
CHAIN_ID=                    # e.g. 84532

# --- News agent (Claude): enables the fifth Oracle signal
ANTHROPIC_API_KEY=
NEWS_MODEL=                  # optional override, default claude-opus-5-5

# --- Formal verification (Harmonic Aristotle): only needed to generate new proofs
ARISTOTLE_API_KEY=

# --- Wallets: WalletConnect Project ID from cloud.reown.com (public, not a secret)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Earn panel (Sentora): set once Sentora confirms the vault
SENTORA_VAULT_ADDRESS=
SENTORA_VAULT_CONFIRMED=     # true / false
SENTORA_FIRELIGHT_COVER=     # true / false
SENTORA_VAULT_NAME=
SENTORA_LLAMA_POOL=
SENTORA_DEPOSIT_URL=
ETH_RPC_URL=                 # Ethereum mainnet RPC for reading the vault (Alchemy/Infura recommended)
