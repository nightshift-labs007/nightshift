# Copy to .env.local and fill in what you need. All optional: the site runs without any of these.
# Never commit .env.local. On Vercel, set the same names under Project → Settings → Environment Variables.

# --- Ledger (Algorand TestNet): 25-word mnemonic of the account that stamps predictions
ALGORAND_MNEMONIC=

# --- Scheduled jobs: long random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# --- On-chain Vault / Guardian (Base Sepolia): one wallet per job; the deployer (owner) stays off the server
DEPLOYER_PRIVATE_KEY=        # only for scripts/deploy-contracts.mjs, keep it local
ORACLE_UPDATER_PRIVATE_KEY=  # pushes Oracle prices on-chain (authorised via NightshiftOracle.setUpdater)
KEEPER_PRIVATE_KEY=          # runs the Guardian (calls protect)
FAUCET_PRIVATE_KEY=          # test-funds faucet (authorised via TestToken.setMinter)
RPC_URL=                     # deploy target RPC, e.g. https://sepolia.base.org
CHAIN_ID=                    # e.g. 84532

# --- News agent (Claude): enables the fifth Oracle signal
ANTHROPIC_API_KEY=
NEWS_MODEL=                  # optional override, default claude-opus-5-5

# --- Second price provider when Yahoo is blocked (free key from twelvedata.com)
TWELVEDATA_API_KEY=

# --- Faucet abuse protection (optional): durable rate limit (Upstash Redis) and captcha (Cloudflare Turnstile)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Keeper alerts to Telegram (low gas, stale prices)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Formal verification (Harmonic Aristotle): only needed to generate new proofs
ARISTOTLE_API_KEY=

# --- Wallets: WalletConnect Project ID from cloud.reown.com (public, not a secret)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Earn panel (Sentora): set once Sentora confirms the vault
SENTORA_VAULT_ADDRESS=
SENTORA_VAULT_CONFIRMED=     # true / false
SENTORA_FIRELIGHT_COVER=     # true / false
SENTORA_VAULT_NAME=
SENTORA_LLAMA_POOL=
SENTORA_DEPOSIT_URL=
ETH_RPC_URL=                 # Ethereum mainnet RPC for reading the vault (Alchemy/Infura recommended)
