{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^trg_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "user_id": {
      "type": "string",
      "pattern": "^usr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "nl_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "compiled_rule": {
      "type": "object",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "geopolitics_energy",
              "conflict_defense",
              "semis_export",
              "monetary_policy",
              "trade_tariffs",
              "china_macro",
              "crypto_regulation",
              "health_policy",
              "earnings_megacap",
              "other"
            ]
          }
        },
        "min_severity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        }
      },
      "required": [
        "categories",
        "min_severity",
        "entities",
        "regions"
      ],
      "additionalProperties": false
    },
    "channels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ws",
          "push",
          "telegram",
          "x",
          "email"
        ]
      }
    },
    "active": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "id",
    "user_id",
    "nl_text",
    "compiled_rule",
    "channels",
    "active",
    "created_at"
  ],
  "additionalProperties": false
}
