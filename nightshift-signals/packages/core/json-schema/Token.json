{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "underlying_ticker": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
    },
    "name": {
      "type": "string",
      "maxLength": 200
    },
    "decimals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 36
    },
    "pool_address": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pool_liquidity_usdg": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d{1,18})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "proxy": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 32
        },
        {
          "type": "null"
        }
      ]
    },
    "beta": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d{1,18})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_close": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d{1,18})?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "active": {
      "type": "boolean"
    },
    "eligible": {
      "type": "boolean"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "symbol",
    "address",
    "underlying_ticker",
    "name",
    "decimals",
    "pool_address",
    "pool_liquidity_usdg",
    "proxy",
    "beta",
    "last_close",
    "active",
    "eligible",
    "updated_at"
  ],
  "additionalProperties": false
}
