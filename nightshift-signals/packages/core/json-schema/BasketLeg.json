{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "token_symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "token_address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "underlying_ticker": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
    },
    "weight": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.5
    },
    "entry_quote_price": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d{1,18})?$"
    },
    "entry_quote_size_usdg": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d{1,18})?$"
    },
    "est_slippage_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "fair_value": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d{1,18})?$"
    },
    "fv_gap_bps": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "token_symbol",
    "token_address",
    "underlying_ticker",
    "weight",
    "entry_quote_price",
    "entry_quote_size_usdg",
    "est_slippage_bps",
    "fair_value",
    "fv_gap_bps"
  ],
  "additionalProperties": false
}
