{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^bkt_\\d{8}_\\d{4}_[a-z0-9]{1,16}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "thesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "thesis_i18n": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 480
      }
    },
    "direction": {
      "type": "string",
      "enum": [
        "long",
        "short"
      ]
    },
    "legs": {
      "minItems": 2,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "token_symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "token_address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$"
          },
          "underlying_ticker": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9.]{0,9}$"
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.5
          },
          "entry_quote_price": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,18})?$"
          },
          "entry_quote_size_usdg": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,18})?$"
          },
          "est_slippage_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "fair_value": {
            "type": "string",
            "pattern": "^-?\\d+(\\.\\d{1,18})?$"
          },
          "fv_gap_bps": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "token_symbol",
          "token_address",
          "underlying_ticker",
          "weight",
          "entry_quote_price",
          "entry_quote_size_usdg",
          "est_slippage_bps",
          "fair_value",
          "fv_gap_bps"
        ],
        "additionalProperties": false
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence_calibrated": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "horizon": {
      "type": "string",
      "enum": [
        "next_open",
        "next_close",
        "1w"
      ]
    },
    "max_slip_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    },
    "analog_event_ids": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "canonical_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "commit_tx": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "graded",
        "void"
      ]
    },
    "void_reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "illiquid",
            "token_halted",
            "pool_paused",
            "stale"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "event_id",
    "created_at",
    "published_at",
    "thesis",
    "thesis_i18n",
    "direction",
    "legs",
    "confidence",
    "confidence_calibrated",
    "horizon",
    "max_slip_bps",
    "model_version",
    "prompt_version",
    "analog_event_ids",
    "canonical_hash",
    "commit_tx",
    "status",
    "void_reason"
  ],
  "additionalProperties": false
}
