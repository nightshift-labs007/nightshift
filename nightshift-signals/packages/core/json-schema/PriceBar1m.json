{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "o": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d{1,18})?$"
    },
    "h": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d{1,18})?$"
    },
    "l": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d{1,18})?$"
    },
    "c": {
      "type": "string",
      "pattern": "^-?\\d+(\\.\\d{1,18})?$"
    },
    "source": {
      "type": "string",
      "enum": [
        "dex",
        "futures",
        "spot",
        "chainlink",
        "official_open"
      ]
    }
  },
  "required": [
    "symbol",
    "ts",
    "o",
    "h",
    "l",
    "c",
    "source"
  ],
  "additionalProperties": false
}
