{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sources_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "headline_ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^hl_[0-9A-HJKMNP-TV-Z]{26}$"
      }
    },
    "first_seen_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "triage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "is_market_moving": {
              "type": "boolean"
            },
            "category": {
              "type": "string",
              "enum": [
                "geopolitics_energy",
                "conflict_defense",
                "semis_export",
                "monetary_policy",
                "trade_tariffs",
                "china_macro",
                "crypto_regulation",
                "health_policy",
                "earnings_megacap",
                "other"
              ]
            },
            "regions": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "severity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "entities": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "reason": {
              "type": "string",
              "maxLength": 160
            }
          },
          "required": [
            "is_market_moving",
            "category",
            "regions",
            "severity",
            "entities",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "triaged_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "title",
    "sources_n",
    "headline_ids",
    "first_seen_at",
    "triage",
    "triaged_at"
  ],
  "additionalProperties": false
}
