# Names only. Copy to .env and fill in locally; never commit values.

# Local infra (matches docker-compose.yml)
DATABASE_URL=postgres://nightshift_signals:nightshift_signals@localhost:5432/nightshift_signals
REDIS_URL=redis://localhost:6379

# local = simulated market/chain/news in one process (pnpm dev:local). live = real vendors; fails fast on missing vars.
NIGHTSHIFT_SIGNALS_MODE=local
APP_URL=http://localhost:3000

# Ports and URLs
API_PORT=8787                # falls back to PORT when unset (Railway sets PORT; see docs/DEPLOY_RAILWAY.md)
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Block explorer base for proof links, e.g. https://<explorer>/ (from official docs)
NEXT_PUBLIC_EXPLORER_URL=

# Auth: HS256 secret, 32+ chars (required in live mode)
JWT_SECRET=

# AI. Without a key, local mode uses an offline keyword stand-in labeled offline-demo.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Chain - from official Robinhood Chain and Uniswap docs
ROBINHOOD_CHAIN_RPC_URL=
ROBINHOOD_CHAIN_ID=
LEDGER_CONTRACT_ADDRESS=
COMMITTER_PRIVATE_KEY=
COMMITTER_ADDRESS=
UNISWAP_QUOTER_ADDRESS=
UNISWAP_CHAIN_SLUG=
USDG_ADDRESS=
USDG_DECIMALS=
# Path or URL to the Stock Token list JSON
TOKEN_REGISTRY=

# Tuning (optional)
MAX_SLIP_BPS=
MIN_POOL_LIQUIDITY_USDG=

# Delivery
# Web Push. Local mode generates and keeps a pair in .data/vapid.json.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# X auto-post (OAuth 1.0a user context)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
# Telegram Mini App (BotFather: /newapp gives the t.me/<bot>/<app> link). Webhook secret is any random string.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINIAPP_LINK=
# Public base URL of the API (webhook registration by `pnpm telegram:setup`)
API_PUBLIC_URL=

# Morning voice brief (ElevenLabs). Without a key the brief is text, read by the browser's speech engine.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Lock-screen tracking: iOS Live Activities via APNs token auth (.p8 key), Android via Expo push
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false
EXPO_ACCESS_TOKEN=

# Mobile app (apps/mobile, read by app.config.ts at build time)
APP_BUNDLE_ID=
ANDROID_PACKAGE=
APPLE_TEAM_ID=
EAS_PROJECT_ID=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_APP_URL=
